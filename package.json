{
  "name": "prepweek",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "bun --hot server.ts",
    "build": "rm -rf dist && bun build ./src/index.html --outdir dist --production --splitting --sourcemap=linked --public-path=/ && cp -r public/. dist/",
    "start": "NODE_ENV=production bun server.ts",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p worker",
    "test": "bun test",
    "worker:dev": "wrangler dev",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "@lexical/code": "^0.52.0",
    "@lexical/link": "^0.52.0",
    "@lexical/list": "^0.52.0",
    "@lexical/markdown": "^0.52.0",
    "@lexical/react": "^0.52.0",
    "@lexical/rich-text": "^0.52.0",
    "@lexical/selection": "0.52.0",
    "@lexical/utils": "^0.52.0",
    "lexical": "^0.52.0",
    "react": "^19.3.0",
    "react-aria-components": "^1.21.1",
    "react-dom": "^19.3.0",
    "reconnecting-websocket": "^4.4.0",
    "tinybase": "^10.0.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261005.1",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.147.0"
  }
}
